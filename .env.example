# Backend API (nakamadesk-backend). Must be reachable from the browser too:
# add this site's origin to the backend's CORS_ORIGINS.
NEXT_PUBLIC_API_URL=http://127.0.0.1:8000

# Public address of this site (used for links and search engines)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# Shop contact details. Leave empty until decided: the site falls back to the
# enquiry form instead of a WhatsApp button, and "we will share UPI details".
NEXT_PUBLIC_WHATSAPP=
NEXT_PUBLIC_PHONE=
NEXT_PUBLIC_UPI_ID=

# Shown on the policy pages. The email already defaults to info@vrikshastudios.com;
# the address is left out of the pages until you set it.
NEXT_PUBLIC_EMAIL=
NEXT_PUBLIC_ADDRESS=
